<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Smoke suite. Surefire runs this file on `mvn test`.
  The TestListener handles Extent reporting, screenshots on failure, and the bug sheet.
  Allure's listener registers itself automatically (no entry needed here).
-->
<suite name="Scoot Smoke Suite" verbose="1">

    <listeners>
        <listener class-name="com.scoot.automation.utils.TestListener"/>
    </listeners>

    <test name="Smoke - Launch">
        <classes>
            <class name="com.scoot.automation.tests.SmokeTest"/>
        </classes>
    </test>

</suite>
