<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  DRIVER app suite. MUST run with the driver target:
    mvn test -DsuiteXmlFile=testng-driver.xml -DtargetApp=driver
-->
<suite name="Scoot Driver Suite" verbose="1">

    <listeners>
        <listener class-name="com.scoot.automation.utils.TestListener"/>
    </listeners>

    <test name="Driver - Login">
        <classes>
            <class name="com.scoot.automation.tests.driver.DriverHomeTest"/>
            <class name="com.scoot.automation.tests.driver.DriverMenuTest"/>
        </classes>
    </test>

</suite>
